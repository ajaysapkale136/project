# ==============================================================================
# AI PROJECT ARCHITECT & MULTI-AGENT PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in your root and backend environments.
# NEVER commit raw production credentials or API keys to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & PROFILE SETTINGS
# ------------------------------------------------------------------------------
# Active Spring Profile: 'dev' uses in-memory H2 (PostgreSQL mode); 'prod' uses PostgreSQL
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
APP_NAME=ai-project-architect

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Required when running under 'prod' profile
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/aiproject_architect
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secure_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# ------------------------------------------------------------------------------
# 3. MULTI-AI PROVIDER CREDENTIALS (BACKEND-ONLY - NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# OpenAI (flagship reasoning model; API billing and a key are required)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-6-astra

# Google Gemini (flagship reasoning model; an API key is required)
GEMINI_API_KEY=AIzaSy-your-google-gemini-api-key-here
GEMINI_MODEL=gemini-4-argon

# Anthropic Claude (flagship model; API billing and a key are required)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-opus-5

# Default Multi-AI Routing Strategy: AUTO, GEMINI, OPENAI, CLAUDE
AI_DEFAULT_PROVIDER=AUTO

# ------------------------------------------------------------------------------
# 4. STORAGE & SECURITY SANDBOX
# ------------------------------------------------------------------------------
# Local archive and isolated snapshot storage root
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=500
MAX_ARCHIVE_FILE_COUNT=50000
SANDBOX_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# 5. REDIS & BACKGROUND JOB COORDINATION
# ------------------------------------------------------------------------------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 6. FRONTEND CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Base URL for the Spring Boot REST API
VITE_API_BASE_URL=http://localhost:8080/api/v1
